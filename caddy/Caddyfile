# TLS in front of the Hermes web UI (optional, see docs/rollout.md).
#
# Two ways to reach the UI safely:
#   1. Tailscale only – then no Caddy is needed and no port is exposed
#   2. this reverse proxy with a real certificate
#
# PHX_HOST from .env decides which name the certificate is issued for.
{
	email {$ACME_EMAIL}
}

{$PHX_HOST} {
	encode zstd gzip

	# Websockets for LiveView work without extra configuration.
	reverse_proxy app:4000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
}
