#!/bin/sh
# Sets a new password for a web UI user and ends their sessions (the operator's
# answer to "forgot password"). Run inside the container:
#
#   docker compose exec -it app bin/reset_password user@example.com
#
# The password is read from the terminal (not echoed) and handed over via the
# environment, so it never shows up in shell history or the process list.
set -eu

if [ $# -ne 1 ]; then
  echo "usage: $0 EMAIL" >&2
  exit 64
fi

printf "Neues Passwort (mind. 12 Zeichen): " >&2
stty -echo 2>/dev/null || true
read -r HERMES_ADMIN_PASSWORD
stty echo 2>/dev/null || true
echo >&2

export HERMES_ADMIN_EMAIL="$1" HERMES_ADMIN_PASSWORD

cd -P -- "$(dirname -- "$0")"
exec ./hermes eval Hermes.Release.reset_password
