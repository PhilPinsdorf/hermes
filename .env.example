# Copy to .env via bin/setup, which fills in the secrets below.

# --- Secrets (generated by bin/setup) ---
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
ARI_PASSWORD=

# --- Web UI ---
# Host name / IP the browser uses to reach the UI (Tailscale name or LAN IP).
PHX_HOST=localhost
PHX_URL_SCHEME=http
PHX_URL_PORT=4000
# Interface the UI port binds to. 127.0.0.1 = local only (the Cloudflare Tunnel
# reaches the app inside the Docker network anyway), 0.0.0.0 = whole LAN.
HTTP_BIND=127.0.0.1
# Only needed behind a proxy that terminates TLS without sending
# X-Forwarded-Proto: prevents a redirect loop. Default: true.
# HTTPS_REDIRECT=false

# Only for `docker compose --profile tunnel up -d`: token of the Cloudflare
# Tunnel (Cloudflare dashboard > Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# --- Asterisk REST Interface ---
ARI_URL=http://host.docker.internal:8088
ARI_USER=hermes

# --- Fritz!Box (docs/fritzbox.md) ---
# Address of the Fritz!Box in the LAN.
FRITZBOX_HOST=192.168.178.1
# Credentials of the IP phone created for Hermes in the Fritz!Box
# (Telefonie > Telefoniegeräte > Neues Gerät > LAN/WLAN (IP-Telefon)).
FRITZBOX_SIP_USER=
FRITZBOX_SIP_PASSWORD=
# "stasis": hand calls to Hermes (normal operation)
# "test": answer every call with a test announcement (line check without the app)
HERMES_CALL_MODE=stasis
# Optional overrides; detected automatically when empty.
# SIP_BIND_ADDRESS = LAN IP of this host (route towards FRITZBOX_HOST)
# ARI_BIND_ADDRESS = IP of the docker0 bridge
SIP_BIND_ADDRESS=
ARI_BIND_ADDRESS=
