# Copy to .env via bin/setup, which fills in the secrets below.

# --- Secrets (generated by bin/setup) ---
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
ARI_PASSWORD=

# --- Web UI ---
# Host name / IP the browser uses to reach the UI (Tailscale name or LAN IP).
PHX_HOST=localhost
PHX_URL_SCHEME=http
PHX_URL_PORT=4000
# Interface the UI port binds to. 127.0.0.1 = local only (use Tailscale/Caddy in front),
# 0.0.0.0 = whole LAN.
HTTP_BIND=127.0.0.1

# --- Asterisk REST Interface (used from M4 on) ---
ARI_URL=http://host.docker.internal:8088
ARI_USER=hermes
